# Text files are stored and checked out with LF ...
* text=auto eol=lf
# ... except Windows scripts: cmd.exe misreads labels and blocks in LF-only .bat files.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.docx binary
*.zip binary
*.png binary
*.jpg binary
*.mp4 binary
*.mp3 binary
*.wav binary
